{
  "name": "wvf-wd-client",
  "productName": "WVF WD",
  "version": "2.0.0",
  "description": "WVF WD Multiplatform QWDTT Protocol Client",
  "main": "main.js",
  "author": "WVF WD Team",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "net.wvf.wd.desktop",
    "productName": "WVF WD",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "wvf-wd.exe",
      "wvf-wd"
    ],
    "extraResources": [
      {
        "from": "../wvf-wd.exe",
        "to": "wvf-wd.exe"
      },
      {
        "from": "../wvf-wd",
        "to": "wvf-wd"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WVF WD"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "public/logo.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
